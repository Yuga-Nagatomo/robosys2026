import sys

# 料理名と1人前あたりの推定カロリー
FOODS = {
    "カレーライス": 750,
    "親子丼": 650,
    "牛丼": 700,
    "カツ丼": 900,
    "チャーハン": 600,
    "オムライス": 750,
    "タコライス": 650,
    "醤油ラーメン": 470,
    "味噌ラーメン": 550,
    "豚骨ラーメン": 600,
    "塩ラーメン": 450,
    "焼きそば": 550,
    "ミートソースパスタ": 650,
    "ハンバーグ": 500,
    "生姜焼き": 450,
    "唐揚げ": 600,
    "焼き鮭": 250,
    "サバの味噌煮": 350,
    "肉じゃが": 300,
    "ハンバーガー": 300,
    "チーズバーガー": 400,
    "フライドポテト": 350,
    "ピザ": 600,
    "チキンナゲット": 300,
    "おにぎり": 180,
    "たまごサンド": 350,
    "ツナサンド": 320,
    "トースト": 250,
    "フレンチトースト": 400,
    "餃子": 400,
}


def main():
    keyword = sys.stdin.read().strip()

    if not keyword:
        print("料理名を入力してください。", file=sys.stderr)
        sys.exit(1)

    results = []

    for name, calories in FOODS.items():
        if keyword in name:
            results.append((name, calories))

    if not results:
        print("該当する料理が見つかりません。", file=sys.stderr)
        sys.exit(1)

    for name, calories in results:
        print(f"{name},{calories}")


if __name__ == "__main__":
    main()

